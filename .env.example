# ─── LLM Provider (at least ONE is required) ──────────────────────────────────

# Anthropic Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI GPT-4 (fallback; also required for semantic search embeddings)
OPENAI_API_KEY=sk-...

# ─── Optional API Keys ────────────────────────────────────────────────────────

# OpenWeatherMap — upgrades weather to real-time data (free tier available)
# https://openweathermap.org/api
OPENWEATHER_API_KEY=

# NewsAPI — enables "latest news" queries (free tier available)
# https://newsapi.org
NEWS_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────

# Path to the SQLite database file (defaults to ./docubot.db)
DB_PATH=./docubot.db
